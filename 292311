
#include <stdio.h>

float average(int a[], int n)
{
    int sum = 0;

    for (int i = 0; i < n; i++)
        sum += a[i];

    return (float)sum / n;
}

int main()
{
    int light[5];

    printf("Enter 5 light readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &light[i]);

    printf("Average Light = %.2f\n",
           average(light, 5));

    return 0;
}
