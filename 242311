
#include <stdio.h>

int calculateSum(int a[], int n)
{
    int sum = 0;
    for (int i = 0; i < n; i++)
        sum += a[i];
    return sum;
}

int main()
{
    int a[5], sum;

    printf("Enter 5 readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    sum = calculateSum(a, 5);

    printf("Sum = %d\n", sum);
    printf("Average = %.2f\n", (float)sum / 5);

    return 0;
}
