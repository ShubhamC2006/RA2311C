
#include <stdio.h>

float average(int a[], int n)
{
    int sum = 0;
    for (int i = 0; i < n; i++)
        sum += a[i];

    return (float)sum / n;
}

int main()
{
    int a[5];

    printf("Enter 5 readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    printf("Average = %.2f\n", average(a, 5));
    return 0;
}
