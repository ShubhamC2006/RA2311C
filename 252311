
#include <stdio.h>

float average(int a[], int n)
{
    int sum = 0;
    for (int i = 0; i < n; i++)
        sum += a[i];

    return (float)sum / n;
}

int main()
{
    int a[5], limit;
    float avg;

    printf("Enter 5 readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    printf("Enter limit: ");
    scanf("%d", &limit);

    avg = average(a, 5);

    printf("Average = %.2f\n", avg);

    if (avg > limit)
        printf("Average exceeds limit\n");
    else
        printf("Average is within limit\n");

    return 0;
}
