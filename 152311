
#include <stdio.h>

int highest(int a[], int n)
{
    int max = a[0];

    for (int i = 1; i < n; i++)
        if (a[i] > max)
            max = a[i];

    return max;
}

int main()
{
    int a[5];

    printf("Enter 5 readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    printf("Highest Reading = %d\n",
           highest(a, 5));
    return 0;
}
