
#include <stdio.h>

float average(int a[], int n)
{
    int sum = 0;

    for (int i = 0; i < n; i++)
        sum += a[i];

    return (float)sum / n;
}

int main()
{
    int d[5];

    printf("Enter 5 distance readings: ");
    for (int i = 0; i < 5; i++)
        scanf("%d", &d[i]);

    printf("Average Distance = %.2f\n",
           average(d, 5));

    return 0;
}
